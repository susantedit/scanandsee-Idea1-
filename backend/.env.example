# ─── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Admin Configuration ──────────────────────────
# Comma-separated list of admin emails
# Users with these emails can access /api/admin/* endpoints
# REQUIRED: Set to your admin email(s)
ADMIN_EMAILS=susantedit@gmail.com

# ─── Google Gemini ────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── USDA FoodData Central ────────────────────────
# Get free key at: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your_usda_api_key_here

# ─── Firebase Admin SDK ───────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=

# ─── Murf AI (voice generation) ──────────────────
# Get free key at: https://murf.ai/api
# Free tier: 10,000 characters/month
MURF_API_KEY=your_murf_api_key_here

# ─── Rate Limits ──────────────────────────────────
FREE_SCAN_LIMIT=5
PREMIUM_SCAN_LIMIT=50
FREE_VOICE_LIMIT=10
FREE_CHAT_LIMIT=20
FREE_COMPARE_LIMIT=3
