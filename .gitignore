# ── Dependencies ──────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── SECRETS — NEVER COMMIT THESE ──────────────────
# Environment files
.env
.env.*
!.env.example          # allow the example template
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Firebase service account keys — CRITICAL: contains private key
*.json
!package.json
!package-lock.json
!tsconfig.json
!jsconfig.json

# Any file that might contain credentials
*secret*
*credential*
*private_key*
*serviceAccount*
*firebase-adminsdk*

# ── Build output ───────────────────────────────────
frontend/dist/
frontend/.vite/
frontend/build/

# ── Logs ──────────────────────────────────────────
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo

# ── Misc ──────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
.cache/
tmp/
temp/
